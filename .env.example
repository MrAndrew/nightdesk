# Night Desk settings. Copy to .env (cp .env.example .env) and edit. .env is ignored by git: real values (keys,
# your lake path, your host names) go there or in your shell, never in a tracked file.
# Every variable the app and its tools read is listed here; okf/environment.md documents each one.
#
# Who reads .env:
# * Docker Compose reads .env next to docker-compose.yml and passes the variables that docker-compose.yml names into
#   the containers (the first sections below). The installer (deploy/install.sh) writes its own .env in
#   ~/.nightdesk with the answers you gave; nothing here is required for a by-hand `docker compose up -d`.
# * The app itself does NOT read .env. For a native run (uv run python -m osinthub) set variables in the shell that
#   starts it, e.g. `set -a; . ./.env; set +a` first, or export them in your shell profile (~/.zshenv also reaches
#   non-interactive shells). Values in the "Native runs" section reach Docker only if you add them to
#   docker-compose.yml's `environment:`.
# The HLTA_ prefix is the project's old name, kept so existing setups keep working.

# --- Who can reach it ------------------------------------------------------------------------------
# 127.0.0.1 = this computer only, no sign-in. 0.0.0.0 = your network too: Caddy then asks for the password below on
# every request. Caddy refuses to start on any other value (deploy/Caddyfile), and with 0.0.0.0 but no HLTA_AUTH_HASH.
ND_BIND=127.0.0.1
# The dashboard is https://<first name in HLTA_HOSTS>:HTTPS_PORT/ (plain HTTP is not published). 443 gives an
# address without a port when it is free.
HTTPS_PORT=8443
# Caddy's plain-HTTP port inside the container (not published).
# HTTP_PORT=8080
# Name(s)/IP(s) you type to reach it, comma- or space-separated. The certificate is issued for these names, and the
# app answers only these names. nightdesk.localhost reaches this computer in every browser, with no DNS.
#   ND_BIND=0.0.0.0 example: HLTA_HOSTS="nightdesk.local, 192.0.2.10, localhost"
HLTA_HOSTS="nightdesk.localhost, localhost"
# The certificate comes from Caddy's own authority (no public domain needed), so browsers warn until you trust it.
# The installer trusts it on this computer; other devices download it from https://<name>:<port>/ca/root.crt.

# --- Sign-in (with ND_BIND=0.0.0.0) ----------------------------------------------------------------
HLTA_AUTH_USER=nightdeskuser
# A bcrypt hash of the password (never the password itself); the installer makes one. By hand, this adds the line
# ('$' doubled to '$$', which an unquoted .env value needs):
#   printf 'HLTA_AUTH_HASH=%s\n' "$(docker run --rm caddy:2.8.4-alpine caddy hash-password --plaintext 'your-password' | sed 's/\$/$$/g')" >> .env
# (A single quote in the password must be written as '\'' inside the quotes.) A single-quoted value needs no doubling:
#   HLTA_AUTH_HASH='$2a$14$....'
# HLTA_AUTH_HASH=

# --- Data ------------------------------------------------------------------------------------------
# A host folder for the data lake instead of the Docker volume "lake" (the installer uses this computer's app-data
# folder, the same one a native run uses), e.g. on an external drive:
# LAKE_DIR=/Volumes/MyDrive/night-desk
# Moving it later: Settings › Data › Change… shows the command (install.sh --move-data NEW-FOLDER).
# The user and group the app runs as, so files in LAKE_DIR belong to you (the installer sets your own: id -u, id -g).
# ND_UID=1000
# ND_GID=1000
# The installer's own folder and Compose project (it writes both); Compose passes the folder to the app as
# OSINTHUB_INSTALL_DIR so Settings can show the move command.
# NIGHTDESK_HOME=~/.nightdesk
# ND_PROJECT=nightdesk
# OSINTHUB_INSTALL_DIR=

# --- Optional source keys (empty = the source runs without it, or stays off) -----------------------
# abuse.ch Auth-Key, free at https://auth.abuse.ch/ . Turns on ThreatFox and URLhaus (malware IOCs
# matched against your network logs). abuse.ch free tier: not-for-profit use, no redistribution.
# ABUSECH_AUTH_KEY=
# ransomware.live PRO API key (paid, https://my.ransomware.live/). Switches the leak-site victims
# source to the PRO API; without it the free, rate-limited API is used.
# RANSOMWARELIVE_API_KEY=
# Only if ransomware.live changes its PRO API details: endpoint URL and key header (default X-API-KEY).
# RANSOMWARELIVE_API_URL=
# RANSOMWARELIVE_API_KEY_HEADER=

# --- Optional online basemaps ------------------------------------------------------------------------
# Your own CARTO basemaps key (https://carto.com/basemaps; free for non-commercial use within CARTO's limits).
# With it the world map offers CARTO's Dark Matter and Positron basemaps, credited "© OpenStreetMap contributors,
# © CARTO"; without it only the local basemap is shown. The key goes to your browser, which sends it to CARTO.
# CARTO_API_KEY=

# --- Optional services -----------------------------------------------------------------------------
# Optional Qdrant vector index (docker compose --profile qdrant up -d); an API key locks it down anyway.
# QDRANT_API_KEY=
# Local AI helper on the host (Apple silicon only): uv run python -m osinthub.ai.server
# AI_URL=http://host.docker.internal:8790
# Device log uploads (Network > Import > Device uploads): the host port, and the address devices use.
# INGEST_PORT=8788
# INGEST_URL=https://192.0.2.10:8788
# 1 = no outbound fetching at all; the app serves only what it already has.
# OSINTHUB_OFFLINE=0
# 1 = turn on the SQL console (read-only SQL over the data lake, in the gear menu); off by default.
# OSINTHUB_SQL_CONSOLE=0
# 1 = the general debug switch; today it only turns the SQL console on too.
# OSINTHUB_DEBUG=0

# --- Native runs (nightdesk, or uv run python -m osinthub) -----------------------------------------
# Where the data lake lives (default: the app-data folder, ~/Library/Application Support/Night Desk on macOS,
# ~/.local/share/nightdesk on Linux). Keep it on a mounted drive:
# the app refuses to start when the path is under an unmounted /Volumes/<name>.
# OSINTHUB_LAKE=/Volumes/ExternalDrive/night-desk
# The DuckDB warehouse and the vector store, if not inside the lake (defaults <lake>/db/hub.duckdb, vectors.duckdb).
# OSINTHUB_DB=
# OSINTHUB_VECTORS_DB=
# Address and port the app listens on (default 127.0.0.1:8787, this machine only). Any other address (0.0.0.0, a LAN
# address, a host name) puts it on your network: it then refuses to start without OSINTHUB_PASSWORD.
# OSINTHUB_HOST=127.0.0.1
# OSINTHUB_PORT=8787
# The app's password (HTTP Basic: the browser asks once; any user name; at least 8 characters). Needed for any bind
# beyond 127.0.0.1; when set, every request needs it, except /api/health from this machine. Plain HTTP on a LAN can be sniffed: beyond a trusted
# home network put a TLS proxy (Caddy, the Docker setup) in front instead.
# OSINTHUB_PASSWORD=
# 1 = a reverse proxy in front already asks for a password, so the app neither refuses a non-loopback bind nor asks
# again. Docker Compose sets it (Caddy signs in). Never set it without such a proxy: the app would be open.
# OSINTHUB_TRUST_PROXY_AUTH=
# Extra host names the app answers to, comma- or space-separated (a reverse proxy's name). Loopback always works.
# OSINTHUB_ALLOWED_HOSTS=nightdesk.lan
# Proxies whose X-Forwarded-Proto/-For uvicorn trusts (read by uvicorn; default 127.0.0.1,::1). Never * on a LAN bind.
# FORWARDED_ALLOW_IPS=
# Vector index: auto (Qdrant if reachable, else DuckDB), qdrant or duckdb; the Qdrant address and a collection prefix.
# OSINTHUB_VECTORS=auto
# QDRANT_URL=http://127.0.0.1:6335
# OSINTHUB_QDRANT_PREFIX=
# 1 = the AI helper is expected, so the app shows it red when it is down (otherwise grey "optional").
# AI_HELPER=
# Cloudflare Radar API token for the routing watch (or save one in Settings; the environment wins).
# CLOUDFLARE_RADAR_TOKEN=
# Network-log inbox folder watched for new Zeek files (default <lake>/inbox/zeek).
# OSINTHUB_INBOX=
# Device upload listener: 1 = on at start; bind address and port; the address devices are told to use; your own
# TLS certificate and key files (default: a self-signed pair in the lake).
# OSINTHUB_INGEST=
# OSINTHUB_INGEST_HOST=
# OSINTHUB_INGEST_PORT=8788
# OSINTHUB_INGEST_URL=https://192.0.2.10:8788
# OSINTHUB_INGEST_CERT=
# OSINTHUB_INGEST_KEY=
# In a container: the host folder behind the lake (Compose sets it from LAKE_DIR); 1/0 overrides container detection.
# OSINTHUB_LAKE_HOST=
# OSINTHUB_DOCKER=
# Safety switches: skip feature packages (comma-separated, e.g. entities,news); news without vectors (1);
# accept an EPSS file much smaller than the one loaded (1, once).
# OSINTHUB_DISABLE_EXT=
# OSINTHUB_NEWS_NO_VECTORS=
# OSINTHUB_EPSS_ALLOW_SHRINK=
# The commit shown in Settings > About when there is no .git folder (container images).
# NIGHTDESK_COMMIT=
# Source endpoints, only if a provider moves them (defaults in the source modules).
# OSINTHUB_RISLIVE_URL=
# OSINTHUB_RIPESTAT_URL=
# OSINTHUB_RADAR_URL=
# OSINTHUB_RPKI_URL=
# OSINTHUB_RPKI_FALLBACK_URL=

# --- The AI helper (uv run python -m osinthub.ai.server; Apple silicon) ----------------------------
# Address and port of the helper (default 127.0.0.1:8790). Beyond loopback it refuses to start without AI_TOKEN.
# AI_HOST=127.0.0.1
# AI_PORT=8790
# The helper's Bearer token: required when AI_HOST is not loopback, checked whenever set. Set the same value where the
# app runs (Docker Compose passes it to the app container), so the app sends it.
# AI_TOKEN=
# Extra Host names the helper answers to (loopback and host.docker.internal always work), comma- or space-separated.
# AI_ALLOWED_HOSTS=
# AI_CHAT_MODEL=mlx-community/Qwen3.8-27B-8bit
# AI_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# AI_EMBED_MAX_TOKENS=1024
# AI_EMBED_BATCH=32
# 0 = embeddings only, no chat model (for a smaller machine).
# AI_CHAT=1

# --- Developer tools (tools/, tests/eval; the app never reads these) -------------------------------
# Scratch lakes of tools/scratch-server.sh and tools/gate.sh (default $TMPDIR/nd-lakes), a lake to clone into
# them, gate output (default $TMPDIR/nd-gates) and the E2E port range (default 9880-9889).
# ND_LAKES=
# ND_LAKE_BASE=
# ND_GATE_OUT=
# ND_E2E_PORTS=
# The eval report cache outside the worktree (default tests/eval/cache), the seed lake tests/eval/zeek_planted.py
# reads, and your live lake, which tests/eval/offline_check.py then refuses to touch.
# ND_EVAL_CACHE=
# ND_SEED_LAKE=
# ND_LIVE_LAKE=
# A private patterns file (kept outside the repo) that tools/release_scan.py and the unit suite also check.
# NIGHTDESK_SCAN_PATTERNS=
